
# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mahatme-eye-hospital

# JWT Secret - replace with a secure value locally
JWT_SECRET=replace_with_a_random_secret

# Server Port
PORT=5000

# Admin Credentials - use local demo values only
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=replace_with_a_strong_password

# File Upload Settings (MB)
MAX_FILE_SIZE_MB=10

# Environment
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

